API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://filmless:filmless_local@localhost:5432/filmless
POISKKINO_API_KEY=
KINOPOISK_UNOFFICIAL_API_KEY=
TMDB_READ_TOKEN=

# Local playtesting of editorially reviewed assets; does not approve rights.
LOCAL_CONTENT_PREVIEW=false

# Email/password: Docker defaults to local Mailpit http://localhost:8025.
# For public deployment configure a real SMTP server and HTTPS WEB_ORIGIN.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Filmless <hello@filmless.local>"
SMTP_USER=
SMTP_PASSWORD=
# Server-only OAuth credentials. Callback URLs documented in docs/AUTH.md.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
