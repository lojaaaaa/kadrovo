{
  "name": "filmless",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @filmless/api dev\" \"pnpm --filter @filmless/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @filmless/contracts build && pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm db:generate && pnpm db:validate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "api:probe": "node --env-file-if-exists=.env scripts/probe-content.mjs",
    "predev": "pnpm --filter @filmless/contracts build",
    "db:generate": "pnpm --filter @filmless/api db:generate",
    "db:validate": "pnpm --filter @filmless/api db:validate",
    "test:smoke": "node scripts/smoke-rooms.mjs",
    "test:game": "node scripts/smoke-game.mjs",
    "catalog": "pnpm --filter @filmless/api catalog",
    "test:content": "pnpm --filter @filmless/api exec tsx src/content/integration.ts",
    "test:auth": "pnpm --filter @filmless/api exec tsx src/auth/integration.ts",
    "test:product": "node scripts/smoke-product.mjs",
    "test:chronology": "node scripts/smoke-chronology.mjs",
    "test:guest": "node scripts/smoke-guest-access.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript-eslint": "^8.72.1",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "concurrently": "^10.0.6",
    "@types/node": "^26.6.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
